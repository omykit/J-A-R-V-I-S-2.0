# Frontend configuration (Vite).
#
# Copy to .env.local to override. Every VITE_ variable is embedded into the
# built JavaScript and is therefore PUBLIC — never put a secret, API key or
# credential in this file or in .env.local.
#
# Backend configuration is separate and lives in the repository-root .env.

# JARVIS Gateway base URL.
# Defaults to http://localhost:8080 when unset.
VITE_GATEWAY_URL=http://localhost:8080

# Name the gateway uses to personalise AI replies (owner_name in POST /chat).
# Optional; the gateway defaults to "" and simply skips personalisation.
VITE_OWNER_NAME=
