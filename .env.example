# ─── Database (memory-service, prefix JARVIS_MEMORY_) ───
# NeonDB (or any Postgres-compatible database). TLS is handled in code
# (services/memory/memory_service/database.py) via an SSLContext, not URL
# query params — if you paste Neon's own connection string as-is, it's fine
# that it includes ?sslmode=require&channel_binding=require; those are
# stripped automatically since asyncpg doesn't accept them directly.
JARVIS_MEMORY_DATABASE_URL=postgresql+asyncpg://jarvis:changeme@localhost:5432/jarvis
# Set to false only if connecting to a local Postgres without TLS configured.
JARVIS_MEMORY_DB_SSL=true
JARVIS_MEMORY_ECHO_SQL=false

# ─── AI / LLM (ai-service, prefix JARVIS_AI_) ───
# Ollama runs on the HOST (not in Docker — see docs/architecture.md), while
# ai-service runs inside a container. From inside a container, "localhost"
# means the container itself, not the host, so it must use Docker Desktop's
# host.docker.internal to reach host-installed Ollama.
# Only use http://localhost:11434 if you're running ai-service directly on
# the host via uvicorn (docs/setup.md's "Run services individually"), not
# through docker-compose.
JARVIS_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
JARVIS_AI_MODEL=jarvis
JARVIS_AI_API_KEY=ollama
JARVIS_AI_MEMORY_SERVICE_URL=http://localhost:8001

# ─── Command service (prefix JARVIS_CMD_) ───
JARVIS_CMD_MEMORY_SERVICE_URL=http://localhost:8001
JARVIS_CMD_WEATHER_API_KEY=
JARVIS_CMD_OPENWEATHER_API_KEY=
# IANA timezone (e.g. Asia/Kuwait) for time requests that name no location.
# Leave empty to detect it from IP geolocation instead.
JARVIS_CMD_DEFAULT_TIMEZONE=

# ─── Gateway (prefix JARVIS_GW_) ───
JARVIS_GW_AI_SERVICE_URL=http://localhost:8002
JARVIS_GW_COMMAND_SERVICE_URL=http://localhost:8003
JARVIS_GW_MEMORY_SERVICE_URL=http://localhost:8001
JARVIS_GW_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://127.0.0.1:3000

# ─── Voice client (unprefixed — read directly via os.environ) ───
GATEWAY_URL=http://localhost:8080
WEATHER_API_KEY=
OPENWEATHER_API_KEY=
